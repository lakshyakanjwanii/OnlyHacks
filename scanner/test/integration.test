import { describe, it, expect, beforeEach } from 'vitest';
import { parseGS1 } from '../gs1Parser';
import { detectConflict, resetScanHistory } from '../conflictDetector';
import { logScan, getAuditLogs, clearAuditLogs } from '../utils/auditLogger';

describe('Phase 10: End-to-End Pipeline Integration', () => {
  beforeEach(() => {
    resetScanHistory();
    clearAuditLogs();
    localStorage.clear();
  });

  it('completes a full end-to-end scan pipeline without conflicts', () => {
    // 1. Raw GS1 string input
    const rawBarcode = '01089123456789001728013110LOT001\u001D21SER001';

    // 2. Step 1: Parse GS1 payload
    const parsed = parseGS1(rawBarcode);
    expect(parsed.gtin).toBe('08912345678900');
    expect(parsed.expirationDate).toBe('2028-01-31');
    expect(parsed.lotNumber).toBe('LOT001');
    expect(parsed.serialNumber).toBe('SER001');

    // 3. Step 2: Run conflict detection
    const conflictResult = detectConflict(parsed);
    expect(conflictResult.status).toBe('clean');

    // 4. Step 3: Record to persistent audit logger
    const updatedLogs = logScan(parsed, conflictResult);

    expect(updatedLogs).toHaveLength(1);
    expect(updatedLogs[0].status).toBe('clean');
    expect(updatedLogs[0].gtin).toBe('08912345678900');
  });

  it('detects and logs a serial number duplication conflict across sequential scans', () => {
    const scan1Raw = '01089123456789001728013110LOT001\u001D21SER001';
    const scan2Raw = '01089123456789001729013110LOT001\u001D21SER001'; // Same serial, different expiry date

    // First scan execution
    const parsed1 = parseGS1(scan1Raw);
    const conflict1 = detectConflict(parsed1);
    logScan(parsed1, conflict1);

    // Second scan execution (Duplicate detection)
    const parsed2 = parseGS1(scan2Raw);
    const conflict2 = detectConflict(parsed2);
    logScan(parsed2, conflict2);

    const allLogs = getAuditLogs();

    expect(allLogs).toHaveLength(2);
    expect(conflict2.status).toBe('conflict');
    expect(conflict2.message).toContain('Duplicate serial number detected');
    expect(allLogs[0].status).toBe('conflict'); // Most recent log on top
  });
});